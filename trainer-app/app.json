      "supportsTablet": false
    },
    "android": {
      "package": "in.vis.trainer",
      "adaptiveIcon": {
        "backgroundColor": "#F9F6F0"
      }
    },
    "jsEngine": "hermes",
    "plugins": [
      "expo-status-bar"
    ]
  }
}
