{
  "expo": {
    "name": "Vis Trainer",
    "slug": "vis-trainer",
    "version": "0.1.0",
    "orientation": "portrait",
    "userInterfaceStyle": "automatic",
    "splash": {
      "resizeMode": "contain",
      "backgroundColor": "#F9F6F0"
    },
    "ios": {
